# ─── ORCID OAuth ─────────────────────────────────────────────────────────────
# Register a public application at https://orcid.org/developer-tools
# Scope used: /authenticate (verifies identity, no extra permissions).
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:4321/api/orcid/callback
# Optional overrides for sandbox testing:
# ORCID_AUTH_BASE=https://sandbox.orcid.org
# ORCID_API_BASE=https://pub.sandbox.orcid.org

# ─── GitHub App (flags + claims) ─────────────────────────────────────────────
# Create at https://github.com/settings/apps with permissions:
#   - Contents: Read & write
#   - Issues: Read & write
#   - Pull requests: Read & write
# Install on codika-io/charted; copy the Installation ID from the URL.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Paste the PEM with literal \n separators OR a single-line PEM. Both work.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_REPO_OWNER=codika-io
GITHUB_REPO_NAME=charted

# ─── Session signing key ─────────────────────────────────────────────────────
# Any high-entropy string. Rotating invalidates all sessions.
AUTH_JWT_SECRET=

# ─── Rate limiting (optional in dev) ────────────────────────────────────────
# Without these, an in-memory limiter is used (per-process, resets on restart).
# Required in production.
#
# Vercel's "Upstash for Redis" integration auto-provisions KV_REST_API_URL +
# KV_REST_API_TOKEN; those work as-is. For standalone Upstash, use:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
KV_REST_API_URL=
KV_REST_API_TOKEN=
