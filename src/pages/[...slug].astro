---
import { getCollection, render } from 'astro:content';
import { getDomainFromId } from '../lib/domain';
import TopicLayout from '../layouts/TopicLayout.astro';
import AtlasGraph from '../components/islands/AtlasGraph';
import { neighborhood, getNode, graph } from '../lib/graph';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map(topic => ({
    params: { slug: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content, headings } = await render(topic);
const domain = getDomainFromId(topic.id);

// Build breadcrumbs from the slug
const parts = topic.id.split('/');
const breadcrumbs = parts.map((part: string, i: number) => {
  const slug = parts.slice(0, i + 1).join('/');
  const isLast = i === parts.length - 1;
  const label = part.replace(/-/g, ' ').replace(/^index$/, parts[i - 1] || 'home');
  return {
    label: label.charAt(0).toUpperCase() + label.slice(1),
    href: isLast ? undefined : `/${slug}`,
  };
});

// Get children topics (direct children of this topic), sorted by order
const allTopics = (await getCollection('topics')).filter(t => t.data.status !== 'archived');
const topicBase = topic.id.replace(/\/index$/, '');
const children = allTopics
  .filter(t => t.data.parent === topicBase || t.data.parent === topic.id)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const filePath = topic.filePath ?? `src/content/topics/${topic.id}.mdx`;

// ── Mini-graph: ancestor + descendant closure for this topic ──
const graphNode = getNode(topic.id);
const sub = graphNode ? neighborhood(topic.id) : { nodes: [], edges: [] };
const miniNodes = sub.nodes.map(n => ({
  id: n.id,
  title: n.title,
  description: n.description,
  color: n.color,
  tier: n.tier,
  status: n.status,
  ancestors: n.ancestors,
  descendants: n.descendants,
  reviewerHandles: n.reviewerHandles,
}));
const miniEdges = sub.edges.map(e => ({ from: e.from, to: e.to }));
const showMiniGraph = miniNodes.length > 1;

// ── Reviewers credited to this topic (from build-graph reviewer overlay) ──
const reviewerHandles = graphNode?.reviewerHandles ?? [];
const reviewersForTopic = graph.reviewers.filter(r => reviewerHandles.includes(r.github));

// ── Sources for this topic ──
const sources = topic.data.sources ?? [];

// ── Tier badge ──
const tier = topic.data.reviewTier ?? 'foundation';
const tierColors: Record<string, string> = {
  foundation: 'bg-surface-100 text-surface-700 border-surface-300',
  field: 'bg-accent-50 text-accent-700 border-accent-300',
  frontier: 'bg-accent-100 text-accent-800 border-accent-500',
};

// Sidebar data — only for topic pages (parent contains "/", e.g. "mathematics/logic")
// Archived topics still build pages (so old URLs work) but render in
// single-column mode — their branch is also archived and out of scope.
const isTopicPage = !!topic.data.parent && topic.data.parent.includes('/') && topic.data.status !== 'archived';

const h2Headings = headings.filter((h: { depth: number }) => h.depth === 2);

// Siblings: all topics sharing the same parent, sorted by order
const siblings = isTopicPage
  ? allTopics
      .filter(t => t.data.parent === topic.data.parent && !t.id.endsWith('/index'))
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : [];

// Branches: all topics with parent === domain (branch indexes), sorted by order
const branches = isTopicPage
  ? allTopics
      .filter(t => t.data.parent === domain)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : [];

// Current branch: the branch index matching this topic's parent
const currentBranch = isTopicPage
  ? branches.find(b => {
      const branchBase = b.id.replace(/\/index$/, '');
      return branchBase === topic.data.parent;
    })
  : undefined;
---

<TopicLayout
  title={topic.data.title}
  description={topic.data.description}
  filePath={filePath}
  breadcrumbs={breadcrumbs}
  isTopicPage={isTopicPage}
  h2Headings={h2Headings}
  siblings={siblings}
  branches={branches}
  currentBranch={currentBranch}
  currentTopicId={topic.id}
  domain={domain}
>
  {/* ── Tier + status badges ── */}
  <div class="flex flex-wrap gap-2 mb-6">
    <span class={`font-mono text-[10px] uppercase tracking-wider px-2 py-1 border ${tierColors[tier]}`}>
      {tier} tier
    </span>
    {topic.data.status === 'archived' && (
      <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-1 border border-surface-300 bg-surface-100 text-surface-500">
        archived (outside MVP scope)
      </span>
    )}
  </div>

  <!-- Short MDX content (2-3 sentences) -->
  <div class="prose mb-10">
    <Content />
  </div>

  {/* ── Sources ── */}
  {sources.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xl mb-4">Sources</h2>
      <ul class="space-y-3">
        {sources.map(s => (
          <li class="border-l-2 border-surface-200 pl-4">
            <div class="font-mono text-[10px] uppercase tracking-wider text-surface-400 mb-1">
              {s.type} · {s.role}{s.year ? ` · ${s.year}` : ''}
            </div>
            <div class="text-sm">
              {s.url || s.arxiv || s.doi ? (
                <a
                  href={s.url ?? (s.arxiv ? `https://arxiv.org/abs/${s.arxiv}` : `https://doi.org/${s.doi}`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent-600 underline decoration-dotted"
                >
                  {s.title}
                </a>
              ) : (
                <span>{s.title}</span>
              )}
            </div>
            {s.authors.length > 0 && (
              <div class="text-xs text-surface-500 mt-1">{s.authors.join(', ')}</div>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ── Mini-graph ── */}
  {showMiniGraph && (
    <section class="mb-10">
      <h2 class="text-xl mb-4">In context</h2>
      <p class="text-sm text-surface-500 mb-4">Where this topic sits in the prerequisite graph. Click any node to jump.</p>
      <AtlasGraph
        client:only="react"
        nodes={miniNodes}
        edges={miniEdges}
        initialRoot={topic.id}
        initialMode="explore"
        height={420}
        compact
      />
      <p class="text-xs text-surface-500 mt-3">
        <a href={`/atlas?root=${encodeURIComponent(topic.id)}&mode=pathTo`} class="underline decoration-dotted hover:text-accent-600">
          Open in full atlas →
        </a>
      </p>
    </section>
  )}

  {/* ── Reviewers ── */}
  {reviewersForTopic.length > 0 && (
    <section class="mb-10">
      <h2 class="text-xl mb-4">Reviewed by</h2>
      <ul class="flex flex-wrap gap-3">
        {reviewersForTopic.map(r => (
          <li>
            <a
              href={`/contributors/${r.github}`}
              class="inline-flex items-center gap-2 border border-surface-200 hover:border-accent-500 px-3 py-2 transition-colors"
            >
              <span class="font-mono text-xs text-surface-500">@{r.github}</span>
              <span class="font-mono text-[10px] uppercase tracking-wider text-surface-400">{r.tier}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Table of contents: ordered children -->
  {children.length > 0 && (
    <div>
      <h2 class="text-xl mb-6">Explore</h2>
      <ol class="space-y-4">
        {children.map((child, i) => (
          <li>
            <a
              href={`/${child.id}`}
              class="group flex items-start gap-5 p-5 border border-surface-200 hover:border-accent-500 transition-colors relative"
              data-hover-sound
            >
              <span class="font-mono text-2xl text-surface-300 group-hover:text-accent-500 transition-colors leading-none pt-0.5 shrink-0">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <h3 class="font-mono text-base uppercase tracking-wider group-hover:text-accent-600 transition-colors mb-1">
                  {child.data.title}
                </h3>
                <p class="text-surface-500 text-sm leading-relaxed">{child.data.description}</p>
              </div>
              <div class="absolute top-0 left-0 w-1 h-full bg-accent-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  )}
</TopicLayout>
