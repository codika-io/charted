---
import type { Domain } from '../lib/domain';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContributeButton from '../components/ContributeButton.astro';
import OrcidStatus from '../components/islands/OrcidStatus';
import FlagWidget from '../components/islands/FlagWidget';
import DottedSeparator from '../components/DottedSeparator.astro';
import BranchSidebar from '../components/BranchSidebar.astro';
import SectionNav from '../components/SectionNav.astro';

interface Props {
  title: string;
  description: string;
  filePath: string;
  breadcrumbs: { label: string; href?: string }[];
  isTopicPage?: boolean;
  h2Headings?: { slug: string; text: string; depth: number }[];
  siblings?: { id: string; data: { title: string; status: 'stub' | 'draft' | 'review' | 'complete' | 'archived'; order: number } }[];
  branches?: { id: string; data: { title: string; order: number } }[];
  currentBranch?: { id: string; data: { title: string; order: number } };
  currentTopicId?: string;
  domain?: Domain;
}

// ── Review CTA copy ──
// Surface review-this-topic as the primary action at the foot of every topic
// page. Reviewers are the whole point: agents draft, humans review.
const reviewCardId = `review-${(Astro.props.currentTopicId ?? 'topic').replace(/[^a-z0-9]/gi, '-')}`;

const {
  title,
  description,
  filePath,
  breadcrumbs,
  isTopicPage = false,
  h2Headings = [],
  siblings = [],
  branches = [],
  currentBranch,
  currentTopicId = '',
  domain,
} = Astro.props;
---

<BaseLayout title={title} description={description} domain={domain}>
  {isTopicPage ? (
    <!-- Topic page: 3-column grid on desktop -->
    <div class="max-w-[90rem] mx-auto px-6 py-12 lg:grid lg:grid-cols-[240px_1fr_240px] lg:gap-8">
      <BranchSidebar
        branches={branches}
        currentBranch={currentBranch!}
        siblings={siblings}
        currentTopicId={currentTopicId}
        h2Headings={h2Headings}
      />

      <div class="min-w-0 max-w-3xl mx-auto">
        <Breadcrumbs items={breadcrumbs} />

        <header class="mb-6">
          <h1 class="text-4xl md:text-5xl mb-4">{title}</h1>
          <p class="text-surface-600 text-lg leading-relaxed">{description}</p>
        </header>

        <DottedSeparator />

        <slot />

        <DottedSeparator />

        {currentTopicId && (
          <section
            id={reviewCardId}
            class="border border-surface-300 px-6 py-8 my-2 text-center"
            aria-labelledby={`${reviewCardId}-title`}
          >
            <h2 id={`${reviewCardId}-title`} class="text-xl mb-2">Review this topic</h2>
            <p class="text-sm text-surface-600 max-w-xl mx-auto mb-5">
              This page was drafted by an agent and is waiting on expert review. Spotted a wrong prerequisite, a missing concept, a misattributed source, or a factual slip? Tell us — your review opens a tracked issue maintainers act on.
            </p>
            <div class="flex justify-center mb-5">
              <FlagWidget
                client:only="react"
                topicId={currentTopicId}
                label="Review this topic"
                variant="cta-large"
                defaultKind="factual-error"
              />
            </div>
            <div class="flex flex-wrap justify-center items-center gap-3 text-xs">
              <OrcidStatus client:only="react" returnTo={Astro.url.pathname} />
              <span class="text-surface-300">·</span>
              <ContributeButton filePath={filePath} />
            </div>
          </section>
        )}
      </div>

      <SectionNav headings={h2Headings} />
    </div>
  ) : (
    <!-- Non-topic page: single centered column (unchanged) -->
    <div class="max-w-4xl mx-auto px-6 py-12">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mb-6">
        <h1 class="text-4xl md:text-5xl mb-4">{title}</h1>
        <p class="text-surface-600 text-lg leading-relaxed">{description}</p>
      </header>

      <DottedSeparator />

      <slot />

      <DottedSeparator />

      {currentTopicId ? (
        <section
          id={reviewCardId}
          class="border border-surface-300 px-6 py-8 my-2 text-center"
          aria-labelledby={`${reviewCardId}-title`}
        >
          <h2 id={`${reviewCardId}-title`} class="text-xl mb-2">Review this topic</h2>
          <p class="text-sm text-surface-600 max-w-xl mx-auto mb-5">
            This page was drafted by an agent and is waiting on expert review. Spotted a wrong prerequisite, a missing concept, a misattributed source, or a factual slip? Tell us — your review opens a tracked issue maintainers act on.
          </p>
          <div class="flex justify-center mb-5">
            <FlagWidget
              client:only="react"
              topicId={currentTopicId}
              label="Review this topic"
              variant="cta-large"
              defaultKind="factual-error"
            />
          </div>
          <div class="flex flex-wrap justify-center items-center gap-3 text-xs">
            <OrcidStatus client:only="react" returnTo={Astro.url.pathname} />
            <span class="text-surface-300">·</span>
            <ContributeButton filePath={filePath} />
          </div>
        </section>
      ) : (
        <div class="flex justify-center">
          <ContributeButton filePath={filePath} />
        </div>
      )}
    </div>
  )}
</BaseLayout>
